# این فایل را به config/.env کپی کنید و مقادیر واقعی را وارد کنید. config/.env هرگز کامیت نمی‌شود.

# اگر از SQL Authentication استفاده می‌کنید:
DB_AUTH_MODE=sql
DB_USER=
DB_PASSWORD=

# اگر از Windows Authentication استفاده می‌کنید، فقط این را تنظیم کنید و بالا را خالی بگذارید:
# DB_AUTH_MODE=windows

# Secrets
.env
config/*.local.yaml

# Data & models (large / sensitive — never versioned)
data/raw/*
data/interim/*
data/processed/*
!data/raw/.gitkeep
!data/interim/.gitkeep
!data/processed/.gitkeep
models/*
!models/.gitkeep
reports/figures/*
!reports/figures/.gitkeep

# Python
__pycache__/
*.pyc
.ipynb_checkpoints/
*.egg-info/
build/
dist/
.pytest_cache/

# Conda / venv
.conda/
venv/

# OS / IDE
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json

# Run logs (console output — reproducible by re-running the scripts)
logs/
*.log
